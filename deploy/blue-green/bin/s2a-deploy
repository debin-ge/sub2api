#!/usr/bin/env bash
# s2a-deploy <slug> [image_tag] —— 蓝绿发布主流程（FR-2 / FR-3）。
#
#   读取状态(nginx upstream 为真相) → 数据层就绪 → 拉起新 slot(自动跑迁移)
#   → 健康门禁 → 版本/slot 校验 → 改写 upstream + nginx -t + reload
#   → 记录 STATE → 异步排空旧 slot,命令立即返回
#
# 失败语义（D3）：切流量之前的任何失败都会自动回收新 slot 且不触碰 nginx 配置,
# 线上不受影响。

set -euo pipefail
# shellcheck source=../lib/common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/common.sh"

[ $# -ge 1 ] && [ $# -le 2 ] || die "用法: s2a-deploy <slug> [image_tag]"
SLUG="$1"
TAG="${2:-}"

require_root
require_cmd curl jq
require_docker_access
command -v nginx >/dev/null 2>&1 || die "nginx 不可用"
load_sites
slug_exists "$SLUG" || die "清单中不存在 stack: $SLUG"

STACK_DIR="$STACKS_DIR/$SLUG"
[ -f "$STACK_DIR/compose.app.yml" ] \
    || die "缺少渲染产物,先执行 sudo ./bin/s2a-render && sudo ./bin/s2a-init $SLUG"
acquire_stack_lock "$SLUG"

PORT_BASE=$(site_attr "$SLUG" port_base)
DRAIN_SECONDS=$(site_attr "$SLUG" drain_seconds 960)
HEALTH_TIMEOUT=$(site_attr "$SLUG" health_timeout_seconds 300)
HEALTH_INTERVAL=$(site_attr "$SLUG" health_interval_seconds 3)
[ -n "$TAG" ] || TAG=$(site_attr "$SLUG" image_tag)
[ -n "$TAG" ] || die "未指定 image_tag 且清单中无默认值"

UPSTREAM_CONF=$(upstream_conf_path "$SLUG")

# ── 1. 读取当前状态（D1：以 nginx upstream 文件为准） ──────────────────────
CUR_PORT=$(current_port_from_upstream "$SLUG") \
    || die "upstream 文件不存在: ${UPSTREAM_CONF}（先执行 sudo ./bin/s2a-render）"
CUR_SLOT=$(slot_for_port "$PORT_BASE" "$CUR_PORT") \
    || die "upstream 端口 $CUR_PORT 不在 $SLUG 的区间内（port_base=${PORT_BASE}）,请人工核查"

CUR_TAG=$(state_get "$SLUG" tag || true)
[ -n "$CUR_TAG" ] || CUR_TAG=$(sed -n 's/.*tag=\([^ ]*\).*/\1/p' "$UPSTREAM_CONF" | head -1)
[ -n "$CUR_TAG" ] || CUR_TAG=unknown

# 首次部署：当前 slot 没有运行中的容器 → 原地部署到当前 slot,无旧 slot 可排空
FIRST_DEPLOY=false
if app_running "$SLUG" "$CUR_SLOT" "$CUR_PORT" "$CUR_TAG"; then
    NEW_SLOT=$(other_slot "$CUR_SLOT")
else
    FIRST_DEPLOY=true
    NEW_SLOT="$CUR_SLOT"
fi
NEW_PORT=$(port_for_slot "$PORT_BASE" "$NEW_SLOT")

if [ "$FIRST_DEPLOY" = true ]; then
    log "deploy $SLUG: 首次部署 → ${NEW_SLOT}:${NEW_PORT} tag=${TAG}"
else
    log "deploy $SLUG: ${CUR_SLOT}(${CUR_TAG}) → ${NEW_SLOT}(${TAG})"
fi

# fail_deploy <原因>：输出三要素后以非 0 退出（补偿动作已在调用前执行）
fail_deploy() {
    warn "发布失败: $1"
    warn "补偿动作: 已回收新 slot ${NEW_SLOT} 的容器"
    warn "线上影响: 无 —— nginx 配置未被修改,流量仍在 ${CUR_SLOT}:${CUR_PORT}"
    exit 1
}

recover_new_slot() {
    app_compose "$SLUG" "$NEW_SLOT" "$NEW_PORT" "$TAG" down --remove-orphans >/dev/null 2>&1 || true
}

# ── 2. 目标 slot 若仍在排空,先取消其回收定时器再接管 ──────────────────────
if cancel_teardown "$SLUG" "$NEW_SLOT"; then
    warn "目标 slot ${NEW_SLOT} 存在待执行的排空定时器,已取消(由本次发布接管)"
fi
if [ "$FIRST_DEPLOY" = false ] && app_running "$SLUG" "$NEW_SLOT" "$NEW_PORT" "$TAG"; then
    warn "目标 slot ${NEW_SLOT} 仍在排空期运行;拉起新容器前会等待其在途请求结束(最长 ${DRAIN_SECONDS}s)"
fi

# ── 3. 数据层就绪（FR-2.2） ───────────────────────────────────────────────
log "确认数据层(postgres/redis)健康..."
data_compose "$SLUG" up -d --wait \
    || die "数据层未能进入 healthy 状态,发布中止(线上不受影响)"

# ── 4. 拉起新 slot（容器启动时自动执行 DB 迁移,受 advisory lock 保护） ──
log "拉起新 slot ${NEW_SLOT}:${NEW_PORT} (image tag: ${TAG})..."
if ! app_compose "$SLUG" "$NEW_SLOT" "$NEW_PORT" "$TAG" up -d --pull always --force-recreate; then
    recover_new_slot
    fail_deploy "新 slot 容器启动命令失败"
fi

# ── 5. 健康门禁（FR-3.1~3.3;超时需覆盖迁移时间） ─────────────────────────
log "健康门禁: 轮询 http://127.0.0.1:${NEW_PORT}/health (间隔 ${HEALTH_INTERVAL}s,总超时 ${HEALTH_TIMEOUT}s)..."
deadline=$(( $(date +%s) + HEALTH_TIMEOUT ))
until health_probe "$NEW_PORT" >/dev/null; do
    if [ "$(date +%s)" -ge "$deadline" ]; then
        warn "健康检查超时,新 slot 最近 200 行日志如下:"
        app_compose "$SLUG" "$NEW_SLOT" "$NEW_PORT" "$TAG" logs --tail 200 || true
        recover_new_slot
        fail_deploy "健康门禁超时(${HEALTH_TIMEOUT}s)"
    fi
    sleep "$HEALTH_INTERVAL"
done

# ── 5b. 版本与 slot 校验（FR-3.5）：确认应答的确实是预期的新容器 ─────────
health_body=$(health_probe "$NEW_PORT" || true)
actual_slot=$(printf '%s' "$health_body" | jq -r '.slot // empty' 2>/dev/null || true)
actual_version=$(printf '%s' "$health_body" | jq -r '.version // empty' 2>/dev/null || true)

if [ -n "$actual_slot" ] && [ "$actual_slot" != "$NEW_SLOT" ]; then
    recover_new_slot
    fail_deploy "slot 校验失败: /health 返回 slot=${actual_slot},预期 ${NEW_SLOT}(端口上可能存在残留容器)"
fi
if printf '%s' "$TAG" | grep -qE '^v?[0-9]+(\.[0-9]+)*'; then
    if [ -n "$actual_version" ] && [ "${actual_version#v}" != "${TAG#v}" ]; then
        recover_new_slot
        fail_deploy "版本校验失败: /health 返回 version=${actual_version},预期 ${TAG}"
    fi
else
    [ -z "$actual_version" ] || log "运行版本: ${actual_version}(tag '${TAG}' 非版本号格式,跳过强校验)"
fi
log "健康门禁通过"

# ── 6. 切流量：改写 upstream 单行 + nginx -t + reload（FR-3.4） ───────────
cp "$UPSTREAM_CONF" "${UPSTREAM_CONF}.bak"
render_upstream_conf "$SLUG" "$NEW_PORT" "$NEW_SLOT" "$TAG" > "$UPSTREAM_CONF"
if ! nginx -t; then
    mv "${UPSTREAM_CONF}.bak" "$UPSTREAM_CONF"
    recover_new_slot
    fail_deploy "nginx -t 校验失败(upstream 已还原备份,未执行 reload)"
fi
nginx -s reload
rm -f "${UPSTREAM_CONF}.bak"
log "流量已切至 ${NEW_SLOT}:${NEW_PORT}"

# ── 7. 记录状态(仅辅助;真相始终是 upstream 文件) ─────────────────────────
if [ "$FIRST_DEPLOY" = true ]; then
    state_write "$SLUG" "$NEW_SLOT" "$TAG" "" ""
else
    state_write "$SLUG" "$NEW_SLOT" "$TAG" "$CUR_SLOT" "$CUR_TAG"
fi

# ── 8. 异步排空旧 slot,命令立即返回（FR-2.8 / D4） ────────────────────────
if [ "$FIRST_DEPLOY" = true ]; then
    log "首次部署完成,无旧 slot 需要排空"
else
    schedule_teardown "$SLUG" "$CUR_SLOT" "$DRAIN_SECONDS"
    log "旧 slot ${CUR_SLOT} 停止接收新请求,将在 ${DRAIN_SECONDS}s 后自动回收"
fi

log "发布成功: $SLUG 当前生效 ${NEW_SLOT}:${NEW_PORT} tag=${TAG}"
[ "$FIRST_DEPLOY" = true ] || log "如需回退: sudo ./bin/s2a-rollback ${SLUG}（排空窗口内秒级生效;注意回滚不撤销已应用的数据库迁移）"
