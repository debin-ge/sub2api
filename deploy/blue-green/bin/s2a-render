#!/usr/bin/env bash
# s2a-render —— sites.yaml → 渲染全部产物（FR-5）。
#
# 流程：
#   1. 校验：slug 格式、port_base 区间无重叠、域名无重复、TLS 证书文件存在
#   2. 对每个 stack 渲染 stacks/<slug>/compose.{data,app}.yml 与
#      /etc/nginx/sub2api/sites/<slug>.conf
#   3. upstreams/<slug>.conf 不存在时初始化为 blue（存在则绝不改写，FR-5.4）
#   4. 安装公共 http 配置与 proxy snippet
#   5. nginx -t 通过才 reload
#
# 幂等：可随时重跑，不影响运行中的容器。

set -euo pipefail
# shellcheck source=../lib/common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/common.sh"

require_root
require_cmd jq curl
command -v docker >/dev/null 2>&1 || warn "docker 不可用,渲染可继续,部署前需安装"
command -v nginx >/dev/null 2>&1 || die "nginx 不可用,无法校验与加载配置"

load_sites

# ---------------------------------------------------------------------------
# 校验（FR-5.5）：任一失败即中止，不产出任何文件
# ---------------------------------------------------------------------------
log "校验清单 $REGISTRY_FILE ..."

slugs=$(all_slugs)
[ -n "$slugs" ] || die "清单中没有任何 stack"

fail=0
seen_slugs=""
seen_domains=""
port_ranges="" # 形如 "slug:start:end" 每行一条

while IFS= read -r slug; do
    if ! printf '%s' "$slug" | grep -qE '^[a-z0-9][a-z0-9-]*$'; then
        warn "slug 非法: '$slug'（仅允许小写字母/数字/连字符）"
        fail=1
        continue
    fi
    case "$seen_slugs" in
        *" $slug "*) warn "slug 重复: $slug"; fail=1 ;;
    esac
    seen_slugs="$seen_slugs $slug "

    domain=$(site_attr "$slug" domain)
    [ -n "$domain" ] || { warn "$slug 缺少 domain"; fail=1; }
    case "$seen_domains" in
        *" $domain "*) warn "域名重复: ${domain}（${slug}）"; fail=1 ;;
    esac
    seen_domains="$seen_domains $domain "

    port_base=$(site_attr "$slug" port_base)
    if ! printf '%s' "$port_base" | grep -qE '^[0-9]+$'; then
        warn "$slug 的 port_base 非法: '$port_base'"
        fail=1
        continue
    fi
    range_start=$port_base
    range_end=$((port_base + 9))
    while IFS=: read -r other os oe; do
        [ -n "$other" ] || continue
        if [ "$range_start" -le "$oe" ] && [ "$os" -le "$range_end" ]; then
            warn "端口区间重叠: $slug($range_start-$range_end) 与 $other($os-$oe)"
            fail=1
        fi
    done <<EOF_RANGES
$port_ranges
EOF_RANGES
    port_ranges="$port_ranges
$slug:$range_start:$range_end"

    tls_cert=$(site_path_attr "$slug" '.tls.cert')
    tls_key=$(site_path_attr "$slug" '.tls.key')
    [ -n "$tls_cert" ] || { warn "$slug 缺少 tls.cert"; fail=1; }
    [ -n "$tls_key" ] || { warn "$slug 缺少 tls.key"; fail=1; }
    [ -z "$tls_cert" ] || [ -f "$tls_cert" ] || { warn "$slug TLS 证书不存在: $tls_cert"; fail=1; }
    [ -z "$tls_key" ] || [ -f "$tls_key" ] || { warn "$slug TLS 私钥不存在: $tls_key"; fail=1; }

    [ -f "$ENVS_DIR/$slug.env" ] || warn "$slug 的密钥文件缺失: ${ENVS_DIR}/${slug}.env（s2a-init 前需就位）"
done <<EOF_SLUGS
$slugs
EOF_SLUGS

[ "$fail" -eq 0 ] || die "清单校验失败,未渲染任何产物"
log "校验通过"

# ---------------------------------------------------------------------------
# 渲染
# ---------------------------------------------------------------------------
mkdir -p "$NGINX_UPSTREAMS_DIR" "$NGINX_SITES_DIR" "$NGINX_SNIPPET_DIR"

# nginx.conf 的 http {} 只需 include 一次本目录下的 *.conf；map、upstream 与
# site include 均由此托管文件统一维护，避免每新增站点再改 nginx.conf。
render_template "$TEMPLATES_DIR/nginx-http.conf.tmpl" \
    "NGINX_S2A_DIR=$NGINX_S2A_DIR" > "$NGINX_S2A_DIR/http.conf"

while IFS= read -r slug; do
    stack_dir="$STACKS_DIR/$slug"
    mkdir -p "$stack_dir"

    domain=$(site_attr "$slug" domain)
    port_base=$(site_attr "$slug" port_base)
    image_repo=$(site_attr "$slug" image_repo weishaw/sub2api)
    bind_host=$(site_attr "$slug" bind_host 127.0.0.1)
    drain_seconds=$(site_attr "$slug" drain_seconds 960)
    tz=$(site_attr "$slug" tz Asia/Shanghai)
    client_max_body_size=$(site_attr "$slug" client_max_body_size 32m)
    proxy_connect_timeout=$(site_attr "$slug" proxy_connect_timeout 10s)
    proxy_send_timeout=$(site_attr "$slug" proxy_send_timeout 960s)
    proxy_read_timeout=$(site_attr "$slug" proxy_read_timeout 960s)
    tls_cert=$(site_path_attr "$slug" '.tls.cert')
    tls_key=$(site_path_attr "$slug" '.tls.key')

    render_template "$TEMPLATES_DIR/compose.data.yml.tmpl" \
        "SLUG=$slug" "TZ=$tz" > "$stack_dir/compose.data.yml"

    render_template "$TEMPLATES_DIR/compose.app.yml.tmpl" \
        "SLUG=$slug" \
        "IMAGE_REPO=$image_repo" \
        "BIND_HOST=$bind_host" \
        "DRAIN_SECONDS=$drain_seconds" \
        "TZ=$tz" > "$stack_dir/compose.app.yml"

    render_template "$TEMPLATES_DIR/nginx-site.conf.tmpl" \
        "DOMAIN=$domain" \
        "SLUG=$slug" \
        "SLUG_US=$(slug_us "$slug")" \
        "TLS_CERT=$tls_cert" \
        "TLS_KEY=$tls_key" \
        "NGINX_SNIPPET_DIR=$NGINX_SNIPPET_DIR" \
        "CLIENT_MAX_BODY_SIZE=$client_max_body_size" \
        "PROXY_CONNECT_TIMEOUT=$proxy_connect_timeout" \
        "PROXY_SEND_TIMEOUT=$proxy_send_timeout" \
        "PROXY_READ_TIMEOUT=$proxy_read_timeout" > "$NGINX_SITES_DIR/$slug.conf"

    upstream_conf=$(upstream_conf_path "$slug")
    if [ ! -f "$upstream_conf" ]; then
        render_upstream_conf "$slug" "$(blue_port "$port_base")" blue \
            "$(site_attr "$slug" image_tag unknown)" > "$upstream_conf"
        log "$slug: 初始化 upstream → blue:$(blue_port "$port_base")"
    fi

    log "$slug: compose + nginx site 渲染完成"
done <<EOF_SLUGS2
$slugs
EOF_SLUGS2

# 公共 snippet 属仓库管理产物，始终收敛到仓库版本（M7 配置零漂移）
if [ -f "$NGINX_SNIPPET_DIR/sub2api-proxy.conf" ] \
    && ! cmp -s "$SNIPPET_SRC" "$NGINX_SNIPPET_DIR/sub2api-proxy.conf"; then
    warn "覆盖已漂移的 $NGINX_SNIPPET_DIR/sub2api-proxy.conf（以仓库版本为准）"
fi
cp "$SNIPPET_SRC" "$NGINX_SNIPPET_DIR/sub2api-proxy.conf"

# ---------------------------------------------------------------------------
# nginx 校验 + reload（FR-5.3）
# ---------------------------------------------------------------------------
if ! nginx -t; then
    die "nginx -t 校验失败,未执行 reload。请检查渲染产物与 nginx.conf 的 include 配置"
fi
nginx -s reload
log "全部产物渲染完成,nginx 已 reload"
