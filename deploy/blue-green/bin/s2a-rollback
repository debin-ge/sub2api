#!/usr/bin/env bash
# s2a-rollback <slug> —— 回滚（FR-4）。
#
#   快速路径: 上一 slot 容器仍在运行且健康 → 仅改回 upstream + reload,秒级
#   降级路径: 上一 slot 已被回收 → 以 prev_tag 重新执行完整发布,分钟级
#
# 注意: 回滚只回滚应用代码,不撤销已应用的数据库迁移（FR-4.5）。

set -euo pipefail
# shellcheck source=../lib/common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/common.sh"

[ $# -eq 1 ] || die "用法: s2a-rollback <slug>"
SLUG="$1"

require_cmd docker curl jq
command -v nginx >/dev/null 2>&1 || die "nginx 不可用"
load_sites
slug_exists "$SLUG" || die "清单中不存在 stack: $SLUG"

PORT_BASE=$(site_attr "$SLUG" port_base)
DRAIN_SECONDS=$(site_attr "$SLUG" drain_seconds 960)
UPSTREAM_CONF=$(upstream_conf_path "$SLUG")

PREV_SLOT=$(state_get "$SLUG" prev_slot || true)
PREV_TAG=$(state_get "$SLUG" prev_tag || true)
[ -n "$PREV_SLOT" ] || die "STATE 中没有可回滚的上一个 slot（可能从未发布或首次部署）"

CUR_PORT=$(current_port_from_upstream "$SLUG") || die "upstream 文件缺失"
CUR_SLOT=$(slot_for_port "$PORT_BASE" "$CUR_PORT") || die "upstream 端口异常,请人工核查"
[ "$CUR_SLOT" != "$PREV_SLOT" ] || die "当前生效 slot 已是 ${PREV_SLOT},无需回滚"

PREV_PORT=$(port_for_slot "$PORT_BASE" "$PREV_SLOT")
CUR_TAG=$(state_get "$SLUG" tag || true)
[ -n "$CUR_TAG" ] || CUR_TAG=unknown

log "rollback $SLUG: ${CUR_SLOT}(${CUR_TAG}) → ${PREV_SLOT}(${PREV_TAG:-unknown})"

# ── 快速路径可用性判定（FR-4.1/4.4：容器在跑且健康才允许秒级切换） ────────
if app_running "$SLUG" "$PREV_SLOT" "$PREV_PORT" "${PREV_TAG:-unknown}" \
    && health_probe "$PREV_PORT" >/dev/null; then

    acquire_stack_lock "$SLUG"

    # 先取消旧 slot 的排空定时器,再切流量,避免切完后目标容器被定时任务销毁（FR-4.3）
    if cancel_teardown "$SLUG" "$PREV_SLOT"; then
        log "已取消 ${PREV_SLOT} 的排空定时器"
    fi

    cp "$UPSTREAM_CONF" "${UPSTREAM_CONF}.bak"
    render_upstream_conf "$SLUG" "$PREV_PORT" "$PREV_SLOT" "${PREV_TAG:-unknown}" > "$UPSTREAM_CONF"
    if ! nginx -t; then
        mv "${UPSTREAM_CONF}.bak" "$UPSTREAM_CONF"
        warn "回滚失败: nginx -t 校验未通过"
        warn "补偿动作: upstream 已还原备份,未执行 reload"
        warn "线上影响: 无 —— 流量仍在 ${CUR_SLOT}:${CUR_PORT}"
        exit 1
    fi
    nginx -s reload
    rm -f "${UPSTREAM_CONF}.bak"

    state_write "$SLUG" "$PREV_SLOT" "${PREV_TAG:-unknown}" "$CUR_SLOT" "$CUR_TAG"

    # 被回滚下线的 slot 同样给足排空窗口后回收
    schedule_teardown "$SLUG" "$CUR_SLOT" "$DRAIN_SECONDS"

    log "回滚完成(快速路径): 流量已切回 ${PREV_SLOT}:${PREV_PORT} tag=${PREV_TAG:-unknown}"
    log "被回滚的 ${CUR_SLOT} 将在 ${DRAIN_SECONDS}s 后回收"
    log "注意: 已应用的数据库迁移不会撤销;旧代码需兼容新 schema(expand-contract)"
    exit 0
fi

# ── 降级路径（FR-4.2）：上一 slot 已回收或不健康 → 以 prev_tag 重新发布 ──
[ -n "$PREV_TAG" ] || die "上一 slot 不可用且 STATE 无 prev_tag,无法降级回滚"
warn "上一 slot ${PREV_SLOT} 容器已回收或不健康,快速路径不可用"
warn "降级为以 tag=${PREV_TAG} 重新执行完整发布 —— 耗时为分钟级(含拉镜像与健康门禁),而非秒级"
log "注意: 已应用的数据库迁移不会撤销;旧代码需兼容新 schema(expand-contract)"
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/s2a-deploy" "$SLUG" "$PREV_TAG"
