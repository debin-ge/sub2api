#!/usr/bin/env bash
# s2a-status [slug] —— 状态查询与不一致检测（FR-7）。
# STATE 文件与 nginx upstream 不一致时,以 nginx 为准并高亮告警（D1 / FR-7.3）。

set -euo pipefail
# shellcheck source=../lib/common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/common.sh"

[ $# -le 1 ] || die "用法: s2a-status [slug]"

require_cmd docker curl jq
load_sites

show_stack() {
    local slug="$1"
    local domain port_base
    domain=$(site_attr "$slug" domain)
    port_base=$(site_attr "$slug" port_base)

    printf '━━━ %s (%s) ━━━\n' "$slug" "$domain"

    local cur_port cur_slot
    if cur_port=$(current_port_from_upstream "$slug"); then
        cur_slot=$(slot_for_port "$port_base" "$cur_port" || printf 'unknown')
        printf '  生效(nginx upstream): %s:%s\n' "$cur_slot" "$cur_port"
    else
        cur_port=""
        cur_slot=""
        printf '  生效(nginx upstream): 未初始化(未执行 s2a-render?)\n'
    fi

    local state_slot state_tag
    state_slot=$(state_get "$slug" slot || true)
    state_tag=$(state_get "$slug" tag || true)
    if [ -n "$state_slot" ]; then
        printf '  STATE 记录: slot=%s tag=%s\n' "$state_slot" "${state_tag:-?}"
        if [ -n "$cur_slot" ] && [ "$state_slot" != "$cur_slot" ]; then
            printf '  ⚠️  不一致: STATE(%s) ≠ nginx(%s) —— 以 nginx 为准,STATE 仅供参考\n' \
                "$state_slot" "$cur_slot"
        fi
    else
        printf '  STATE 记录: 无\n'
    fi

    local slot port marker status health hversion hslot body
    for slot in blue green; do
        port=$(port_for_slot "$port_base" "$slot")
        marker=' '
        [ "$slot" = "$cur_slot" ] && marker='*'
        status=$(docker ps --filter "label=com.docker.compose.project=${slug}-${slot}" \
            --format '{{.Status}} ({{.Image}})' 2>/dev/null | head -1)
        [ -n "$status" ] || status='未运行'
        if body=$(health_probe "$port"); then
            hversion=$(printf '%s' "$body" | jq -r '.version // "?"' 2>/dev/null || printf '?')
            hslot=$(printf '%s' "$body" | jq -r '.slot // "?"' 2>/dev/null || printf '?')
            health="OK version=${hversion} slot=${hslot}"
        else
            health='无响应'
        fi
        printf ' %s%s :%s 容器[%s] 健康[%s]\n' "$marker" "$slot" "$port" "$status" "$health"

        local pending
        if pending=$(teardown_pending "$slug" "$slot"); then
            printf '    ⏳ 待回收: %s\n' "$pending"
        fi
    done
}

if [ $# -eq 1 ]; then
    slug_exists "$1" || die "清单中不存在 stack: $1"
    show_stack "$1"
else
    while IFS= read -r slug; do
        show_stack "$slug"
    done <<EOF_SLUGS
$(all_slugs)
EOF_SLUGS
fi
