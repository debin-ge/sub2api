# ${DOMAIN} —— 渲染自 templates/nginx-site.conf.tmpl，请勿手工编辑（s2a-render 会覆盖）

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     ${TLS_CERT};
    ssl_certificate_key ${TLS_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    access_log /var/log/nginx/${SLUG}.access.log;
    error_log  /var/log/nginx/${SLUG}.error.log warn;

    # /metrics 不对公网暴露（应用侧 bearer 校验之外的第二道防线，FR-6.6）
    location = /metrics {
        return 404;
    }

    location / {
        proxy_pass http://${SLUG_US};
        include /etc/nginx/snippets/sub2api-proxy.conf;
        # 必须 ≥ 应用侧流间隔超时（GATEWAY_IMAGE_STREAM_DATA_INTERVAL_TIMEOUT，默认 900s）
        proxy_read_timeout ${PROXY_READ_TIMEOUT};
    }
}
